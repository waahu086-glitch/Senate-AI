body {
  margin: 0;
  font-family: Arial;
  background: #f0f2f5;
}

.container {
  max-width: 600px;
  height: 100vh;
  margin: auto;
  display: flex;
  flex-direction: column;
  background: white;
}

header {
  display: flex;
  justify-content: space-between;
  padding: 15px;
  background: #111;
  color: white;
}

.chat {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.msg {
  padding: 10px 14px;
  margin: 6px;
  border-radius: 12px;
  max-width: 75%;
  animation: fadeIn 0.3s ease-in;
}

.user {
  background: #007bff;
  color: white;
  align-self: flex-end;
}

.bot {
  background: #e5e5e5;
  align-self: flex-start;
}

.input-box {
  display: flex;
  padding: 10px;
  border-top: 1px solid #ddd;
}

input {
  flex: 1;
  padding: 10px;
  font-size: 16px;
}

button {
  padding: 10px 15px;
  margin-left: 5px;
  cursor: pointer;
}

/* Dark mode */
.dark {
  background: #121212;
  color: white;
}

.dark .container {
  background: #1e1e1e;
}

.dark .bot {
  background: #333;
  color: white;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
